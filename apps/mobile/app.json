{
  "expo": {
    "name": "Jnapanam Sports Zone",
    "slug": "jnapanam-sports-zone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jnapanam-brand.png",
    "scheme": "jnapanamsportszone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/jnapanam-brand.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.jnapanam.sportszone"
    },
    "android": {
      "package": "com.jnapanam.sportszone",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/jnapanam-brand.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/jnapanam-brand.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/jnapanam-brand.png",
          "imageWidth": 140
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jnapanam uses your location with your permission to record where activities occur. You can continue without location.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Jnapanam staff to scan customer check-in QR codes",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Jnapanam to capture your profile photo for venue entry verification",
          "photosPermission": "Allow Jnapanam to select your profile photo",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
