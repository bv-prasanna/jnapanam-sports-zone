# Configure these as Northflank RUNTIME environment variables, NOT build arguments.
# Do not commit passwords, JWT tokens or other real secrets.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://REPLACE_WITH_PRIVATE_POSTGRES_HOST:5432/REPLACE_DB_NAME?sslmode=require
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD=REPLACE_WITH_SECRET
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_SECRET
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_CLOUDFLARE_WEB_DOMAIN
EXPOSE_DEVELOPMENT_RESET_TOKEN=false
PAYMENT_PROVIDER=mock
# Keep mock payments confined to staging. Configure real provider before production.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# FAST2SMS_API_KEY=
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Optional memory tuning, reduce if sandbox limit is small
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
